{
  "name": "smp-main",
  "version": "0.0.37",
  "type": "module",
  "description": "Minecraft server panel",
  "scripts": {
    "dev": "bun run dev.js",
    "start": "bun run start.js",
    "build": "bun --cwd=web run build",
    "build:web": "bun --cwd=web run build",
    "build:server": "bun --cwd=server run build",
    "version": "bun run scripts/version.js get",
    "bump:patch": "bun run scripts/version.js bump",
    "server": "bun --cwd=server run dev",
    "check": "bun --cwd=web run check",
    "test": "bun --cwd=web run test"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "engineStrict": true
}
